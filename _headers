# Early Hints (103): Cloudflare li serve prima dell'HTML — il browser
# inizia a scaricare le risorse critiche durante il tempo di risposta
/
  Link: </style.css?v=15>; rel=preload; as=style
  Link: </vendor/fonts/CormorantGaramond-500.woff2>; rel=preload; as=font; crossorigin

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  X-XSS-Protection: 0
  Access-Control-Allow-Origin: https://mont6cefalu.it
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.basemaps.cartocdn.com; connect-src 'self' https://cloudflareinsights.com; frame-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

# Asset immutabili: cache lunga lato browser (le foto non cambiano mai di nome)
/img/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Dati di prenotazione: sempre freschi, mai indicizzati
/blocked-dates.json
  Cache-Control: no-cache
  X-Robots-Tag: noindex, nofollow

/prezzi.json
  Cache-Control: no-cache
  X-Robots-Tag: noindex, nofollow
